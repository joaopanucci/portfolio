# Supabase (Xadrez online e ranking) — veja docs/supabase.md
# Públicas (vão para o navegador). Em Cloudflare, defina também como "Build variables".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Secreta (somente servidor). NUNCA use o prefixo NEXT_PUBLIC_. Em Cloudflare: Settings → Variables and Secrets.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Opcional: URL do serviço Java (terminal e Nyron Lab)
# NEXT_PUBLIC_JOAOOS_API_URL=https://api.exemplo.com
